---
// The directed SSSP board: a table with one section per edge density and Nil's ordinal chart, both from the board
// data (src/lib/sssp.ts, src/lib/sssp-chart.ts). A point row covers its own density and every sparser one.
import type {RecordEntry} from '../lib/types';
import {math} from '../lib/math';
import {evidenceName,breakthroughLabel} from '../lib/evidence';
import RecordDate from './RecordDate.astro';
import AuthorList from './AuthorList.astro';
import InfoTooltip from './InfoTooltip.astro';
import {density,parse,parseFunction,timeAt,lexCmp,latex,plain,D_NAMES,type Q} from '../lib/sssp';
import {chartModel} from '../lib/sssp-chart';
interface Props {records:RecordEntry[];classic?:RecordEntry;}
const {classic}=Astro.props;
const records=classic?[classic,...Astro.props.records]:Astro.props.records;
const board=(import.meta.glob('../data/*.json',{eager:true,import:'default'}) as Record<string,any>)['../data/directed-sssp.json'];
const byId=new Map(records.map(r=>[r.id,r]));
const points=board.records.filter((r:any)=>r.score.includes(' ; ')).map((r:any)=>({id:r.id,t:parse(r.score)}));
const functions=board.records.filter((r:any)=>!r.score.includes(' ; ')).map((r:any)=>({id:r.id,terms:parseFunction(r.score)}));
const seen=new Map<string,Q[]>();
for(const d of ['n',...board.chart.ticks])seen.set(d,density(d));
for(const p of points)seen.set(latex(p.t.slice(0,2),D_NAMES),p.t.slice(0,2));
const densities=[...seen.values()].sort(lexCmp).filter((d,i,a)=>i===0||lexCmp(d,a[i-1])!==0);
const sections=densities.map(d=>{
 const rows=[
  ...functions.map((f:any)=>({id:f.id,t:timeAt(f.terms,d),from:undefined as Q[]|undefined})),
  ...points.filter((p:any)=>lexCmp(p.t.slice(0,2),d)>=0).map((p:any)=>({id:p.id,t:p.t.slice(2),from:lexCmp(p.t.slice(0,2),d)>0?p.t.slice(0,2):undefined})),
 ].filter(r=>byId.has(r.id)).sort((a,b)=>lexCmp(a.t,b.t));
 return {d,rows:rows.map(r=>({...r,best:lexCmp(r.t,rows[0].t)===0,record:byId.get(r.id)!}))};
});
const labels:Record<string,string>={'classical-baseline':'Dijkstra + Fibonacci heap','duan-et-al-stoc-2025':"STOC'25",'duan-et-al-icalp-2026':"ICALP'26"};
const names:Record<string,string>={...labels,'directed-sssp-2026':'C-HD'};
const dates:Record<string,string>={};for(const r of records)dates[r.id]=r.date??'9999';
const model=chartModel(board,labels,dates);
// Positions in percent of the plot area. The labels, points and rings are HTML on top of the plot, so they keep their
// size and shape when the plot scales to its column (Nil, 2026-11-04: no sideways scrollbar at any width).
const px=(x:number)=>100*x/(model.xs.length-1);
const py=(y:number)=>100-100*y/(model.ys.length-1);
const colors:Record<string,string>={classic:'#2f6fdb',paper:'#e4683a',lean:'#e8a000',lower:'#707070'};
const paperColor:Record<string,string>={'duan-et-al-stoc-2025':'#e4683a','duan-et-al-icalp-2026':'#1fa67a'};
const color=(s:{id:string;kind:string})=>paperColor[s.id]??colors[s.kind];
const cap=board.chart.lines[0];
const receipt=byId.get(cap.row)?.evidenceLevel==='lean-verified'?byId.get(cap.row)?.evidenceUrl:undefined;
---
<section class="sssp-board" aria-label="Results by edge density">
<h2>Best results by edge density</h2>
<p>A result with an edge bound <span set:html={math('D(n)')}/> also holds for every sparser graph, so it is listed under its own density and under each sparser one. The first result in each section is the best known at that density.</p>
<div class="sssp-chart-box"><div class="sssp-chart" role="img" aria-label="Best running time by edge density, ordinal axes"><div class="plot">
 <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
  {model.ys.map((_,y)=><line class="grid" x1="0" x2="100" y1={py(y)} y2={py(y)} vector-effect="non-scaling-stroke"/>)}
  {model.xs.map((_,x)=><line class="grid" y1="0" y2="100" x1={px(x)} x2={px(x)} vector-effect="non-scaling-stroke"/>)}
  {model.series.map(s=><polyline fill="none" stroke={color(s)} stroke-width="3" stroke-dasharray={s.dashed?'8 6':undefined} vector-effect="non-scaling-stroke" points={s.points.map(p=>`${px(p.x)},${py(p.y)}`).join(' ')}/>)}
 </svg>
 {model.series.map(s=>s.points.map(p=><span class="dot" style={`left:${px(p.x)}%;top:${py(p.y)}%;background:${color(s)}`}/>))}
 {model.markers.map(m=><span class="ring" style={`left:${px(m.x)}%;top:${py(m.y)}%`}/>)}
 {model.ys.map((y,i)=><div class="ylab" style={`top:${py(i)}%`} set:html={math(y)}/>)}
 {model.xs.map((x,i)=><div class="xlab" style={`left:${px(i)}%`} set:html={math(x)}/>)}
</div></div></div>
<ul class="sssp-legend">
 {model.series.map(s=><li><span class="swatch" style={`background:${color(s)}`}/>{s.kind==='lower'?<span set:html={math(s.label)}/>:s.label}</li>)}
</ul>
<p class="sssp-note">Both axes are ordered classes, not to scale. Each result is drawn only where it is at least as fast as every earlier one. Below <span set:html={math('m=n')}/> every result is <span set:html={math('O(n)')}/> after unreachable vertices are dropped. {receipt?<><a href={receipt}>Lean Verified</a> at <span set:html={math('m\\le n\\log^{3/4} n')}/> (our run)</>:<>Lean check pending at <span set:html={math('m\\le n\\log^{3/4} n')}/></>}; the C-HD line below that cap is Vals AI's Lean result in their own cost function, not checked against our statement at those densities. ICALP'26: an outside implementer <a href="https://github.com/primaryaesthetics/beyond-dijkstra">reports a flaw in its Lemma 3.7</a> (not checked by us).</p>
{sections.map(s=><section class="density" aria-label={`m at most ${plain(s.d,D_NAMES)}`}>
 <h3>Graphs with <span set:html={math(`m\\le ${latex(s.d,D_NAMES)}`)}/></h3>
 <div class="results-scroll"><table><thead><tr><th scope="col">Time</th><th scope="col">Evidence level</th><th scope="col">Result</th><th scope="col">Date</th></tr></thead><tbody>
 {s.rows.map(r=><tr data-level={r.record.evidenceLevel} class:list={{best:r.best}}>
  <td class="bound"><span set:html={math(`O(${latex(r.t)})`)}/>{r.from&&<span class="from"> (from <span set:html={math(`m\\le ${latex(r.from,D_NAMES)}`)}/>)</span>}{r.best&&r.record.methodNote&&<span class="assumptions"><InfoTooltip label="About this bound"><div class="tip-part"><strong class="tip-head">How it is proved</strong>{' '}{r.record.methodNote}</div></InfoTooltip></span>}</td>
  <td><a href={r.record.evidenceUrl}>{evidenceName(r.record.evidenceLevel)}</a>{r.record.isBreakthrough&&<span class="breakthrough"> · {breakthroughLabel}</span>}</td>
  <td><strong class="name">{names[r.id]??r.record.title}</strong> <AuthorList authors={r.record.authors}/>{r.record.creditNote&&<p class="credit">{r.record.creditNote}</p>}{r.record.predecessors?.map((u:string)=><p class="credit"><a href={u}>Proof source</a></p>)}</td>
  <td>{r.record.id==='classical-baseline'?'1987':<RecordDate record={r.record}/>}</td>
 </tr>)}
 </tbody></table></div>
</section>)}
</section>
<style>
.sssp-board{margin:1.5rem 0}
/* The "How it is proved" tooltip of a section's best row, as RecordTable shows it at rank 1. */
.assumptions{display:inline-block;margin-left:.4rem}.tip-head{display:block;font-weight:600}
/* The chart fits its column at every width. Wide: the axis labels are level. Narrow (the chart under 62rem): smaller
   labels, and the density labels turn 60 degrees so that each one shows complete. */
.sssp-chart-box{container-type:inline-size;max-width:64rem;margin:1rem 0 0}
.sssp-chart{padding:.8rem 2.8rem 2.4rem 7.6rem}
.plot{position:relative;height:max(17rem,40cqi)}
.plot svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}.plot .grid{stroke:var(--border,#ddd);stroke-width:1}
.dot,.ring{position:absolute;border-radius:50%;transform:translate(-50%,-50%)}
.dot{width:10px;height:10px;box-shadow:0 0 0 1.5px var(--bg)}.ring{width:17px;height:17px;border:3px solid var(--lean-verified)}
.ylab{position:absolute;right:100%;margin-right:.5rem;transform:translateY(-50%);font-size:.8rem;white-space:nowrap}
.xlab{position:absolute;top:100%;margin-top:.8rem;transform:translateX(-50%);font-size:.75rem;white-space:nowrap}
@container (max-width:62rem){
 .sssp-chart{padding:.8rem 1.4rem 7.3rem 5.6rem}
 .ylab{font-size:.7rem;margin-right:.35rem}
 .xlab{margin-top:.3rem;transform:translateX(-100%) rotate(-60deg);transform-origin:100% 0}
}
.sssp-legend{display:flex;flex-wrap:wrap;gap:.4rem 1.2rem;list-style:none;padding:0;margin:.6rem 0}.swatch{display:inline-block;width:1.4rem;height:.3rem;margin-right:.4rem;vertical-align:middle}
.sssp-note{font-size:.9rem;max-width:64rem}.density h3{font-size:1.05rem;margin:1.2rem 0 .4rem}.density tr.best td{font-weight:600}.from,.credit{font-weight:400;font-size:.85rem}.credit{margin:.2rem 0 0}
/* Phones: one card per result, so the tables fit the screen too. */
@media(max-width:720px){
 .density table,.density tbody{display:block}.density thead{display:none}
 .density tr{display:grid;grid-template-columns:minmax(0,1fr);border-bottom:1px solid var(--line);padding:.4rem 0}.density tr:last-child{border-bottom:0}
 .density td{border:0;padding:.3rem .8rem;min-width:0;overflow-wrap:anywhere}.density td.bound{white-space:normal}
 .density td:nth-child(4)::before{content:'Date: ';font-weight:600}
}
</style>
